<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wa_compose_form" model="ir.ui.view">
        <field name="name">wa.compose.form</field>
        <field name="model">wa.compose</field>
        <field name="arch" type="xml">
            <form string="Enviar por WhatsApp">
                <group>
                    <field name="partner_id" invisible="1"/>
                    <field name="to" placeholder="51987654321"/>
                    <field name="body"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Enviar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
