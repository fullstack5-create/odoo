<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_l10n_pe_edi" model="ir.ui.view">
        <field name="name">res.company.form.l10n.pe.edi</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="EDI SUNAT (Beta)" name="l10n_pe_edi">
                    <group>
                        <group string="Credenciales">
                            <field name="l10n_pe_edi_env"/>
                            <field name="l10n_pe_edi_sol_user"/>
                            <field name="l10n_pe_edi_sol_pass" password="True"/>
                        </group>
                        <group string="Certificado digital">
                            <field name="l10n_pe_edi_cert" filename="l10n_pe_edi_cert_filename"/>
                            <field name="l10n_pe_edi_cert_filename" invisible="1"/>
                            <field name="l10n_pe_edi_cert_pass" password="True"/>
                            <label for="l10n_pe_edi_cert_pass" string=""/>
                            <div class="text-muted">
                                Sin certificado en Beta se genera uno autofirmado al vuelo.
                            </div>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
